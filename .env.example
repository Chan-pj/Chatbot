# MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=welbot_db

# Groq API (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key

# 공공데이터포털 복지서비스 API 인증키 (https://www.data.go.kr)
WELFARE_API_KEY=your_data_go_kr_service_key

# Flask 세션 키
FLASK_SECRET_KEY=change_me_to_random_string
FLASK_DEBUG=false
